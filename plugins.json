[
  {
    "id": "@dsh-plugin/dsh-agent-plan-entry",
    "name": "DSH Agent Plan Entry",
    "description": [
      {
        "language": "en-US",
        "content": "Adds the enter_plan_mode tool and reminds the agent to plan first for medium or complex tasks, delivering plan-mode guidance at the conversation tail so entering or leaving plan mode never rewrites the cached prompt prefix."
      },
      {
        "language": "zh-CN",
        "content": "提供 enter_plan_mode 工具，并在中等或复杂任务上提醒 Agent 先规划；计划模式指引搬到对话尾部，进入或退出计划模式都不再重写已缓存的提示词前缀。"
      }
    ],
    "support_versions": "[0.2.2-rc.2,0.3.0)",
    "urls": {
      "homepage": "https://github.com/dsh-plugins/dsh-agent-plan-entry",
      "repository": "https://github.com/dsh-plugins/dsh-agent-plan-entry",
      "issues": "https://github.com/dsh-plugins/dsh-agent-plan-entry/issues"
    },
    "relationship": []
  },
